{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bunkialo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_SESSION",
        "class_name": "UserSession"
      },
      {
        "name": "DESKTOP_DIRECTORY",
        "class_name": "DesktopDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DesktopDirectory"]
    }
  ],
  "vars": {
    "ATTENDANCE_PORTAL_URL": "https://attendance.iiitkottayam.ac.in",
    "VAPID_ADMIN_CONTACT": "mailto:noelmcv7@gmail.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
